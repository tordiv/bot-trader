# Copia questo file in .env e inserisci le tue chiavi PAPER di Alpaca.
# .env è in .gitignore: non committarlo mai e non incollarlo in chat.
# Le chiavi paper servono per i dati di mercato e per il conto di prova. Il conto reale (Directa)
# non si collega mai al programma.
APCA_API_KEY_ID=la-tua-chiave-paper
APCA_API_SECRET_KEY=il-tuo-secret-paper

# L'unico valore accettato è "paper": qualsiasi altro valore blocca il programma.
TRADING_MODE=paper

# Invio automatico dei ticket al conto PAPER (python weekly.py --submit-paper).
# Lascia "false" finché non hai verificato test, backtest e dry-run.
PAPER_SUBMIT_ENABLED=false

# Notifiche Telegram opzionali (lascia vuoto per disattivarle).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
