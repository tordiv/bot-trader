# Copia questo file in .env e inserisci le tue chiavi PAPER.
# .env è in .gitignore: non committarlo mai. Su macOS/Linux: chmod 600 .env
APCA_API_KEY_ID=la-tua-chiave-paper
APCA_API_SECRET_KEY=il-tuo-secret-paper

# In questa build l'unico valore accettato è "paper".
TRADING_MODE=paper

# Saldo iniziale del conto paper (usalo uguale al capitale che pensi di usare in live).
STARTING_EQUITY=10000

# Notifiche opzionali (lascia vuoto per disattivarle).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
